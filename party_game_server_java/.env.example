# ==============================================================================
# PartyGame Club - Production Environment Variables Template
# Copy this file to `.env` before running `docker compose up -d --build`
# ==============================================================================

# --- Database (MySQL 8.0) ---
MYSQL_DATABASE=party_game_db
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD
JPA_DDL_AUTO=update

# --- Public Origin, CORS & WebSocket Origins ---
# Example: https://play.yourdomain.com/party-game
PARTY_PUBLIC_BASE_URL=https://play.yourdomain.com
PARTY_CORS_ALLOWED_ORIGINS=https://play.yourdomain.com,https://admin.yourdomain.com
PARTY_WS_ALLOWED_ORIGINS=https://play.yourdomain.com,https://admin.yourdomain.com

# --- Commercial Security Gates (Set all 3 to false in live production) ---
PARTY_ALLOW_PASSWORDLESS_PHONE=false
PARTY_SMS_SANDBOX=false
PARTY_PAYMENT_SANDBOX=false

# --- Developer / Operations Console Authentication ---
# Generate BCrypt hash with:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'YourStrongAdminPass', bcrypt.gensalt()).decode())"
PARTY_ADMIN_PASSWORD_HASH=
# Optional fallback if not using BCrypt hash (keep empty when PARTY_ADMIN_PASSWORD_HASH is set):
PARTY_ADMIN_PASSWORD=
# Comma-separated DB usernames allowed to log into /admin:
PARTY_ADMIN_USERNAMES=admin
